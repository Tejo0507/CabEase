<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

    <servlet>
        <servlet-name>RegisterServlet</servlet-name>
        <servlet-class>com.cabease.servlet.RegisterServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>RegisterServlet</servlet-name>
        <url-pattern>/register</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>LoginServlet</servlet-name>
        <servlet-class>com.cabease.servlet.LoginServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LoginServlet</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>BookingServlet</servlet-name>
        <servlet-class>com.cabease.servlet.BookingServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>BookingServlet</servlet-name>
        <url-pattern>/booking</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AIChatServlet</servlet-name>
        <servlet-class>com.cabease.servlet.AIChatServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AIChatServlet</servlet-name>
        <url-pattern>/ai-chat</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AdminLoginServlet</servlet-name>
        <servlet-class>com.cabease.servlet.AdminLoginServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminLoginServlet</servlet-name>
        <url-pattern>/admin-login</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AddCabServlet</servlet-name>
        <servlet-class>com.cabease.servlet.AddCabServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AddCabServlet</servlet-name>
        <url-pattern>/add-cab</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>EditCabServlet</servlet-name>
        <servlet-class>com.cabease.servlet.EditCabServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>EditCabServlet</servlet-name>
        <url-pattern>/edit-cab</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>DeleteCabServlet</servlet-name>
        <servlet-class>com.cabease.servlet.DeleteCabServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DeleteCabServlet</servlet-name>
        <url-pattern>/delete-cab</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ViewCabsServlet</servlet-name>
        <servlet-class>com.cabease.servlet.ViewCabsServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ViewCabsServlet</servlet-name>
        <url-pattern>/view-cabs</url-pattern>
    </servlet-mapping>

</web-app>
